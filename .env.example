# Salin file ini jadi .env lalu isi tokennya
# cp .env.example .env

# GitHub Personal Access Token
# Buat di: https://github.com/settings/tokens
# Scope yang dibutuhkan: TIDAK PERLU scope khusus untuk GitHub Models
# (cukup token biasa / fine-grained token tanpa permission tambahan)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

